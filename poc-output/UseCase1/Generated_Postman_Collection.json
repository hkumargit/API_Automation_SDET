{
  "info": {
    "_postman_id": "UseCase1-postman-demo",
    "name": "UseCase1 - Postman Demo Collection",
    "description": "Static demo collection for the QA Automation POC. This JSON is generated locally; no LLM is used to create it. Replace the sample endpoints with endpoints supported by your test API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "item": [
    {
      "name": "01 - API root responds",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            ""
          ]
        },
        "description": "Demo request. Change the path to a documented endpoint if needed."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Server returns a successful response', function () {",
              "    pm.expect(pm.response.code).to.be.within(200, 299);",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "02 - Health endpoint responds",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Demo request. Use only if the target API exposes /health."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Health endpoint returns HTTP 200', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "response": []
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://your-test-api.example.com",
      "type": "string"
    }
  ]
}